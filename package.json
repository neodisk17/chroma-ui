{
  "name": "chromadb-ui",
  "version": "1.0.0",
  "description": "ChromaDB Desktop UI - Electron + React + TypeScript",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --mac --win --linux",
    "build:publish": "npm run build && electron-builder --mac --win --linux --publish always",
    "build:docker:win": "docker compose run --rm electron-builder-win",
    "build:docker:linux": "docker compose run --rm electron-builder-linux",
    "build:docker:all": "docker compose up electron-builder-win electron-builder-linux",
    "start": "cross-env NODE_ENV=production electron .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\"",
    "icons:generate": "node scripts/generate-icons.js",
    "script:create-collection": "ts-node scripts/create-collection.ts --name",
    "script:add-documents": "ts-node scripts/add-documents.ts --collection 'text' --file data.json",
    "script:generate-data": "ts-node scripts/generate-sample-data.ts --output data.json --count 100 --with-meta",
    "script:example": "ts-node scripts/example-full-workflow.ts"
  },
  "keywords": [
    "chromadb",
    "electron",
    "react",
    "typescript",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "chromadb": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "html-to-image": "^1.11.13",
    "keytar": "^7.9.0",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.70.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-router-dom": "^6.21.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^23.0.6",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "ts-node": "^1.7.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
