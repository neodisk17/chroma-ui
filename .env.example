# GitHub token for private repo auto-updater and publishing releases
# Required scopes: repo (full control of private repositories)
GH_TOKEN=your_github_personal_access_token

# GitHub repository owner (username or org)
GH_OWNER=your_github_username

# Optional: Code signing (macOS)
# CSC_LINK=path/to/certificate.p12
# CSC_KEY_PASSWORD=certificate_password

# Optional: Code signing (Windows)
# WIN_CSC_LINK=path/to/certificate.pfx
# WIN_CSC_KEY_PASSWORD=certificate_password
